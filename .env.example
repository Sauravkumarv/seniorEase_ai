# SeniorEase AI Environment Configuration Example

# Flask Backend Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:5000

# AI Provider Configuration
# Supported AI_PROVIDER values: 'gemini', 'openai', 'mock'
AI_PROVIDER=gemini

# API Key Credentials (Replace with your actual keys in .env - DO NOT hardcode real keys)
AI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
# Default options: 'gemini-1.5-flash' (Gemini) or 'gpt-3.5-turbo' (OpenAI)
AI_MODEL=gemini-1.5-flash

# Audio Speech-to-Text & Text-to-Speech Configuration
STT_PROVIDER=whisper
TTS_PROVIDER=gtts

# Optional OCR Fallback Configuration
OCR_FALLBACK_ENABLED=True
