# Flask Backend Port Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:5000

# AI Service Configuration
# AI_PROVIDER options: 'openai', 'gemini', or 'mock'
# If set to 'mock' or if API key is omitted, the app will run in local mock mode without requiring an active API key.
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-3.5-turbo
